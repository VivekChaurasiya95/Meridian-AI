# Meridian AI — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# Only variable names and safe placeholders belong in this file.

# --- API service ---
# App environment: dev | test | prod
MERIDIAN_ENV=dev
API_HOST=127.0.0.1
API_PORT=8010

# PostgreSQL connection strings (SQLAlchemy + psycopg dialect).
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5435/meridian
TEST_DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5435/meridian_test

# Comma-separated browser origins allowed to call the API (no wildcard with credentials).
# Both loopback spellings so localhost and 127.0.0.1 work identically.
CORS_ALLOW_ORIGINS=http://localhost:3010,http://localhost:3000,http://127.0.0.1:3010,http://127.0.0.1:3000

# --- Web frontend ---
WEB_PORT=3010
# Base URL of the API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8010

# --- Session auth (M2; all have safe defaults, override as needed) ---
# Set true in production so the session cookie requires HTTPS.
SECURE_COOKIES=false
# BCRYPT_ROUNDS=12
# SESSION_TTL_HOURS=24

# --- Firebase social sign-in (Google + GitHub; alongside password auth) ---
# Backend: project ID only. ID tokens verify against Google's public certs,
# so no service-account secret is needed on the API server. Empty = disabled.
FIREBASE_PROJECT_ID=
# Web frontend (set these in apps/web/.env.local, NOT here): Firebase web
# app config from Firebase console -> Project settings -> Your apps -> Web.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Landing demo video ---
# YouTube link or direct .mp4 URL for the landing "Watch it explained"
# section (set in apps/web/.env.local). Empty = animated placeholder.
# NEXT_PUBLIC_DEMO_VIDEO_URL=

# --- Milestone 3 (project archive ingestion; processed synchronously) ---
# UPLOAD_MAX_MB=25
# EXTRACTED_MAX_MB=200
# MAX_ARCHIVE_FILES=5000
# MAX_ARCHIVE_DEPTH=20
# MAX_COMPRESSION_RATIO=100
# PREVIEW_MAX_BYTES=65536
# INDEX_BUDGET_BYTES=2097152

# --- Milestone 4 (durable jobs; upload hardening + worker tuning) ---
# UPLOAD_RATE_MAX=20
# UPLOAD_RATE_WINDOW_SECONDS=3600
# WORKER_ID=compose-worker-1
# WORKER_LEASE_SECONDS=60
# WORKER_HEARTBEAT_SECONDS=20
# WORKER_POLL_SECONDS=5
# JOB_MAX_ATTEMPTS=5
# JOB_RETRY_BASE_SECONDS=30
# JOB_RETRY_MAX_SECONDS=3600

# --- Milestone 3+ (evidence object storage / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meridian-evidence

# --- Milestone 4+ (background jobs) ---
# JOB_LEASE_TTL_SECONDS=60

# --- Milestone 7+ (model provider for reasoning stages) ---
# Any MODEL_PROVIDER other than "fake" uses the OpenAI-compatible HTTP
# provider (app.services.model_gateway.HttpModelProvider). The default
# ("fake", or unset) means UNCONFIGURED: reasoning stages block honestly
# instead of emitting output. /health/ready reports this as model:
# ok | not_configured (never blocks readiness, never leaks secrets).
# MODEL_PROVIDER=openai_compatible
# MODEL_API_BASE=https://api.example.com/v1
# MODEL_API_KEY=
# MODEL_NAME=
# MODEL_TIMEOUT_SECONDS=60
# MODEL_MAX_ATTEMPTS=3
